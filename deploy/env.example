#!/usr/bin/env bash

# 说明：
# 1. 各接口默认读取自己目录下的 config.yaml
# 2. config.yaml 由 configs/global.yaml + configs/interfaces/*.yaml 生成
# 3. 本文件只建议填写“需要覆盖默认配置”的环境变量
# 4. 如果修改了 configs 源文件，请先执行：
#    python3 scripts/generate_interface_configs.py

# MySQL / SQLite
export MYSQL_ROOT_PASSWORD="change_root_password"
export MYSQL_HOST="127.0.0.1"
export MYSQL_PORT="3306"
export MYSQL_USER="protocol_user"
export MYSQL_PASSWORD="change_me"
export MYSQL_DATABASE="protocol_db"
export MYSQL_USE_SQLITE="false"
export MYSQL_AUTO_FALLBACK_SQLITE="false"
export RUNTIME_DATA_DIR="/srv/interface_projects/runtime_data"
export MYSQL_DATA_DIR="$RUNTIME_DATA_DIR/mysql"
export SQLITE_DB_PATH="$RUNTIME_DATA_DIR/sqlite/protocol_db.sqlite3"

# 模型
export MODEL_CACHE_DIR="/srv/model_cache"
export MODELSCOPE_CACHE_DIR="$MODEL_CACHE_DIR/modelscope"
export LLM_MODEL_DIR="$MODEL_CACHE_DIR/Qwen/Qwen3-4B"
export LLM_MODEL_NAME="$LLM_MODEL_DIR"
export USE_VLLM="true"
export VLLM_URL="http://127.0.0.1:8000"
export EMBED_MODEL_DIR="$MODEL_CACHE_DIR/Qwen/Qwen3-Embedding-0.6B"
export EMBED_MODEL_PATH="$EMBED_MODEL_DIR"
export RERANK_MODEL_DIR="$MODEL_CACHE_DIR/Qwen/Qwen3-Reranker-0.6B"
export VLLM_HOST="0.0.0.0"
export VLLM_PORT="8000"
export VLLM_GPU_DEVICES="0"
export VLLM_TENSOR_PARALLEL_SIZE="1"
export VLLM_MAX_MODEL_LEN="8192"
export VLLM_GPU_MEMORY_UTILIZATION="0.90"

# 计算卡后端
# NVIDIA: nvidia；海光 DCU: dcu
export ACCELERATOR_BACKEND="nvidia"
export ACCELERATOR_VISIBLE_DEVICES="0"
# 海光 DCU 必须使用厂商适配包，并设置为 false
export INSTALL_VLLM_FROM_PYPI="true"
export INSTALL_PROJECT_REQUIREMENTS="true"
export REQUIREMENTS_FILE="/srv/interface_projects/requirements-all.txt"
# 海光 DTK 环境脚本路径；NVIDIA 环境留空
export DTK_ENV_FILE=""

# Milvus Lite (新环境会自动创建空数据库文件)
export MILVUS_AUTO_FALLBACK_LITE="true"
export MILVUS_LITE_URI="$RUNTIME_DATA_DIR/milvus/milvus_lite.db"

# 协议转换知识图谱
export NEO4J_PASSWORD="change_neo4j_password"
export NEO4J_DATA_DIR="$RUNTIME_DATA_DIR/neo4j/data"
export NEO4J_LOGS_DIR="$RUNTIME_DATA_DIR/neo4j/logs"
export PROTOCOL_CONVERSION_GRAPH_BACKEND="neo4j"
export PROTOCOL_CONVERSION_NEO4J_ENABLED="true"
export PROTOCOL_CONVERSION_NEO4J_URI="bolt://127.0.0.1:7687"
export PROTOCOL_CONVERSION_NEO4J_USERNAME="neo4j"
export PROTOCOL_CONVERSION_NEO4J_PASSWORD="$NEO4J_PASSWORD"
export PROTOCOL_CONVERSION_NEO4J_DATABASE="neo4j"
export PROTOCOL_CONVERSION_NEO4J_TIMEOUT_SECONDS="30"
export PROTOCOL_CONVERSION_NEO4J_CONNECTION_TIMEOUT_SECONDS="30"
export PROTOCOL_CONVERSION_NEO4J_MAX_CONNECTION_POOL_SIZE="50"
export PROTOCOL_CONVERSION_JSON_FALLBACK="false"
export PROTOCOL_CONVERSION_WRITE_FALLBACK_JSON="false"
export PROTOCOL_CONVERSION_NEO4J_SCHEMA_MODE="legacy_entity_graph"
export PROTOCOL_CONVERSION_NEO4J_READ_STATUSES="approved,verified"
export PROTOCOL_CONVERSION_NEO4J_WRITE_STATUS="candidate"
