# =============================================================================
# interface_projects 环境变量配置模板
# 复制此文件为 .env 并根据实际环境修改路径
# =============================================================================

# ---- 模型缓存根目录 (所有模型路径基于此目录) ----
# 可通过此变量统一管理所有模型文件的存放位置
# 默认值: ~/model_cache
MODEL_CACHE_DIR=~/model_cache

# ---- 模型路径 (优先级高于 MODEL_CACHE_DIR 自动推导) ----
# 以下变量为空时，会自动从 MODEL_CACHE_DIR 推导:
#   Embedding: $MODEL_CACHE_DIR/Qwen/Qwen3-Embedding-0.6B
#   Reranker:  $MODEL_CACHE_DIR/Qwen3-Reranker-0.6B
#   LLM:       $MODEL_CACHE_DIR/Qwen/Qwen3-4B

# Embedding 模型目录 (Qwen3-Embedding-0.6B)
# EMBED_MODEL_DIR=

# Reranker 模型目录 (Qwen3-Reranker-0.6B)
# RERANK_MODEL_DIR=

# LLM 模型目录 (Qwen3-4B)
# LLM_MODEL_DIR=

# ---- 模型 Repo ID (用于从 ModelScope/HuggingFace 下载) ----
# EMBED_MODEL_REPO=Qwen/Qwen3-Embedding-0.6B
# RERANK_MODEL_REPO=Qwen/Qwen3-Reranker-0.6B
# LLM_MODEL_REPO=Qwen/Qwen3-4B

# ---- Milvus 向量数据库 ----
# MILVUS_LITE_URI=./runtime/milvus/milvus_lite.db

# ---- 协议文档目录 ----
# PROTOCOL_DOCS_DIR=./data/real_docs

# ---- LLM 服务 (vLLM / OpenAI-compatible API) ----
# OPENAI_API_KEY=local-qwen
# OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# OPENAI_MODEL=qwen-local
# VLLM_URL=http://127.0.0.1:8000
